---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Prestige DataOps" description="This page could not be found." noindex>
  <section class="nf theme-dark">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 class="display nf__title">Page <em>not found</em></h1>
      <p class="lede">The page you are looking for does not exist or has moved.</p>
      <a class="btn nf__btn" href="/">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-height: 100vh; display: grid; align-items: center; background: var(--bg); color: var(--fg); padding: calc(var(--header-h) + 40px) 0 80px; }
  .nf__title { margin: 20px 0 20px; font-size: clamp(52px, 8vw, 104px); }
  .nf__btn { margin-top: 32px; }
</style>
